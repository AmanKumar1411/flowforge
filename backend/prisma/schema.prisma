// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// FlowForge V1 - User identity model

enum UserRole {
  STUDENT
  FACULTY
}

enum CycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  batchYear    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseProjectCycles CourseProjectCycle[]

  @@index([role])
  @@index([batchYear])
}

model CourseProjectCycle {
  id                 String      @id @default(uuid())
  courseName         String
  title              String
  description        String?
  batchYear          Int
  semester           Int
  academicYear       String
  submissionStartAt  DateTime
  submissionDeadline DateTime
  status             CycleStatus @default(DRAFT)
  createdByFacultyId String
  createdByFaculty   User        @relation(fields: [createdByFacultyId], references: [id], onDelete: Restrict)
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([createdByFacultyId, createdAt])
  @@index([batchYear, status, publishedAt])
}

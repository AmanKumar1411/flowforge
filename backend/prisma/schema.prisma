// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Identity and access

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
  PENDING_STAFF
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum FacultyAllowlistSource {
  MANUAL
  APPROVED_REQUEST
  CSV_IMPORT
}

enum FacultyAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_DENIED
  USER_CREATED
  ROLE_ASSIGNED
  FACULTY_REQUEST_CREATED
  FACULTY_REQUEST_APPROVED
  FACULTY_REQUEST_REJECTED
  FACULTY_ALLOWLIST_ADDED
  FACULTY_ALLOWLIST_REMOVED
  ELEVATION_DENIED
  USER_BATCH_CORRECTED
  USER_DEACTIVATED
  USER_REACTIVATED
  LOGOUT
  LOGOUT_ALL
  REFRESH_TOKEN_REUSE_DETECTED
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_DISBANDED
  ENROLLMENT_ADDED
  ENROLLMENT_REMOVED
  AUTO_GROUP_APPLIED
  USER_CLAIMED
  IDEA_SUBMITTED
  IDEA_UPDATED
  IDEA_APPROVED
  IDEA_REJECTED
  CATALOG_IDEA_ADDED
  CATALOG_IDEA_UPDATED
  CATALOG_IDEA_REMOVED
  IDEA_PICKED
  SUBMISSION_CREATED
}

model User {
  id           String     @id @default(uuid())
  // Null for a student pre-registered from a faculty import; their first sign-in claims the account.
  googleSub    String?    @unique
  email        String     @unique
  name         String
  avatarUrl    String?
  role         UserRole
  status       UserStatus @default(ACTIVE)
  batchYear    Int?
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  courseProjectCycles    CourseProjectCycle[]
  refreshTokens          RefreshToken[]
  facultyAccessRequest   FacultyAccessRequest?   @relation("RequestingUser")
  decidedFacultyRequests FacultyAccessRequest[]  @relation("RequestDecider")
  addedAllowlistEntries  FacultyAllowlistEntry[]
  auditLogs              AuditLog[]
  ledTeams               Team[]                  @relation("TeamLeader")
  teamMemberships        TeamMember[]            @relation("TeamMemberUser")
  addedTeamMembers       TeamMember[]            @relation("TeamMemberAdder")
  addedEnrollments       CycleEnrollment[]
  teamSeeking            TeamSeeker[]
  submittedIdeas         ProjectIdea[]           @relation("IdeaSubmitter")
  ideaReviews            IdeaReview[]            @relation("IdeaReviewer")
  catalogIdeas           CatalogIdea[]           @relation("CatalogIdeaAuthor")
  submissions            Submission[]            @relation("SubmissionAuthor")

  @@index([role])
  @@index([batchYear])
  @@index([status])
}

model FacultyAllowlistEntry {
  id        String                 @id @default(uuid())
  email     String                 @unique
  name      String?
  source    FacultyAllowlistSource
  addedById String
  addedBy   User                   @relation(fields: [addedById], references: [id], onDelete: Restrict)
  createdAt DateTime               @default(now())
}

model FacultyAccessRequest {
  id          String                     @id @default(uuid())
  userId      String                     @unique
  user        User                       @relation("RequestingUser", fields: [userId], references: [id], onDelete: Restrict)
  email       String
  status      FacultyAccessRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?                      @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())

  @@index([status])
}

model RefreshToken {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  familyId        String
  tokenHash       String        @unique
  expiresAt       DateTime
  familyExpiresAt DateTime
  revokedAt       DateTime?
  replacedById    String?       @unique
  replacedBy      RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces        RefreshToken? @relation("TokenRotation")
  userAgent       String?
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([familyId])
}

// Append-only: the migration adds a trigger that rejects UPDATE and DELETE.
model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
}

// Course and project cycles

enum CycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// CORE: the whole batch takes part. ELECTIVE: only the students the faculty enrolled.
enum CourseKind {
  CORE
  ELECTIVE
}

model CourseProjectCycle {
  id                     String            @id @default(uuid())
  courseName             String
  title                  String
  description            String?
  batchYear              Int
  semester               Int
  academicYear           String
  submissionStartAt      DateTime
  submissionDeadline     DateTime
  // Team rules. The migration adds a CHECK: 1 <= min <= max <= 10.
  minTeamSize            Int               @default(1)
  maxTeamSize            Int               @default(4)
  // Students change their own teams until teamFormationDeadline. The owning faculty then
  // complete teams until teamCompletionDeadline. Teams submit their first idea by ideaDeadline;
  // a rejected idea can be resubmitted until submissionStartAt.
  // The migrations add CHECKs: formation <= completion <= idea deadline <= submissionStartAt.
  teamFormationDeadline  DateTime
  teamCompletionDeadline DateTime
  ideaDeadline           DateTime
  kind                   CourseKind        @default(CORE)
  status                 CycleStatus       @default(DRAFT)
  createdByFacultyId     String
  createdByFaculty       User              @relation(fields: [createdByFacultyId], references: [id], onDelete: Restrict)
  publishedAt            DateTime?
  closedAt               DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  teams                  Team[]
  enrollments            CycleEnrollment[]
  teamSeekers            TeamSeeker[]
  catalogIdeas           CatalogIdea[]

  @@index([createdByFacultyId, createdAt])
  @@index([batchYear, status, publishedAt])
}

// The roster of an elective. Keyed by email so faculty can enroll students who have not
// signed in yet; it is matched to User.email (normalized) when they do.
model CycleEnrollment {
  cycleId   String
  cycle     CourseProjectCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  email     String
  addedById String
  addedBy   User               @relation(fields: [addedById], references: [id], onDelete: Restrict)
  createdAt DateTime           @default(now())

  @@id([cycleId, email])
  @@index([email])
}

// Teams

enum TeamOrigin {
  STUDENT
  FACULTY
  AUTO_GROUP
}

model Team {
  id          String             @id @default(uuid())
  cycleId     String
  cycle       CourseProjectCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  name        String
  // The student who created the team, or the one the faculty chose. Never transferred.
  leaderId    String
  leader      User               @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  origin      TeamOrigin         @default(STUDENT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     TeamMember[]
  idea        ProjectIdea?
  submissions Submission[]

  // Target of TeamMember's composite foreign key, which keeps every member row in its team's cycle.
  @@unique([id, cycleId])
  @@unique([cycleId, leaderId])
  @@index([cycleId, createdAt])
}

// The leader has a row too, so the unique key below covers leaders and members alike.
model TeamMember {
  teamId    String
  // Copied from the team so the database can enforce one team per student per cycle.
  cycleId   String
  team      Team     @relation(fields: [teamId, cycleId], references: [id, cycleId], onDelete: Cascade)
  userId    String
  user      User     @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  // The leader, or the faculty member who placed the student.
  addedById String
  addedBy   User     @relation("TeamMemberAdder", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt   DateTime @default(now())

  @@id([teamId, userId])
  @@unique([cycleId, userId])
  @@index([userId])
}

// A student without a team who wants to be found. Removed when they join a team.
model TeamSeeker {
  cycleId   String
  cycle     CourseProjectCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  note      String?
  createdAt DateTime           @default(now())

  @@id([cycleId, userId])
}

// Ideas

enum IdeaStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum IdeaDecision {
  APPROVED
  REJECTED
}

// PROPOSAL: the team's own idea, reviewed by the faculty. CATALOG: picked from the faculty's list.
enum IdeaSource {
  PROPOSAL
  CATALOG
}

// An idea the cycle's faculty offer; any number of teams can pick it (ADR 014).
model CatalogIdea {
  id          String             @id @default(uuid())
  cycleId     String
  cycle       CourseProjectCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  title       String
  description String
  link        String?
  createdById String
  createdBy   User               @relation("CatalogIdeaAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  // Teams that picked it keep a copy of its content; a picked idea cannot be removed.
  picks       ProjectIdea[]

  // Target of ProjectIdea's composite foreign key: a team picks only from its own cycle's list.
  @@unique([id, cycleId])
  @@index([cycleId, createdAt])
}

// A team's current project idea: one per team, submitted by its leader, reviewed by the owning faculty.
model ProjectIdea {
  id            String       @id @default(uuid())
  teamId        String
  // Copied from the team; the composite foreign key keeps it equal to the team's cycle.
  cycleId       String
  // Goes with the team, which can only be disbanded while students still form teams.
  team          Team         @relation(fields: [teamId, cycleId], references: [id, cycleId], onDelete: Cascade)
  title         String
  // For a pick: the catalog idea's description.
  problem       String
  // Null only for a pick (a CHECK in the migration).
  solution      String?
  link          String?
  status        IdeaStatus   @default(SUBMITTED)
  // A pick is approved at once; CHECKs tie source, catalogIdeaId and status together.
  source        IdeaSource   @default(PROPOSAL)
  catalogIdeaId String?
  catalogIdea   CatalogIdea? @relation(fields: [catalogIdeaId, cycleId], references: [id, cycleId], onDelete: Restrict)
  // 1 for the first version, one more for every change of content.
  // The migration adds a CHECK: version >= 1.
  version       Int          @default(1)
  submittedById String
  submittedBy   User         @relation("IdeaSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  reviews       IdeaReview[]

  // One idea per team (the team id alone decides the cycle).
  @@unique([teamId, cycleId])
  @@index([cycleId, status])
  @@index([catalogIdeaId])
}

// One faculty decision on one version of an idea; the history stays when the team resubmits.
model IdeaReview {
  id         String       @id @default(uuid())
  ideaId     String
  idea       ProjectIdea  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  version    Int
  decision   IdeaDecision
  // Required for a rejection (checked by the app and a CHECK in the migration).
  feedback   String?
  reviewerId String
  reviewer   User         @relation("IdeaReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now())

  @@unique([ideaId, version])
}

// Submissions

// One version of a team's work. Every save adds a version; the latest is the current one (ADR 015).
model Submission {
  id            String   @id @default(uuid())
  teamId        String
  // Copied from the team; the composite foreign key keeps it equal to the team's cycle.
  cycleId       String
  team          Team     @relation(fields: [teamId, cycleId], references: [id, cycleId], onDelete: Restrict)
  // 1, 2, 3… per team. The migration adds a CHECK: version >= 1.
  version       Int
  repositoryUrl String
  demoUrl       String?
  reportUrl     String?
  notes         String?
  submittedById String
  submittedBy   User     @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime

  @@unique([teamId, version])
  @@index([cycleId, submittedAt])
}

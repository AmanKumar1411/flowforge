# Runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://flowforge:replace_with_local_database_password@localhost:5432/flowforge?schema=public
FRONTEND_URL=http://localhost:5173

# Google Sign-In (OAuth client of type "Web application" in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
ALLOWED_HOSTED_DOMAIN=nst.rishihood.edu.in

# University identity rules
STUDENT_EMAIL_PATTERN=^[a-z]+\.[a-z]*(\d{2})[a-z]*@nst\.rishihood\.edu\.in$
STAFF_EMAIL_PATTERN=^[a-z]+\.[a-z]+\d?@nst\.rishihood\.edu\.in$
BATCH_BASE_YEAR=2000
BATCH_MIN_YEAR=2018
# Comma-separated staff emails that become ADMIN on login. Student emails are refused at boot.
ADMIN_BOOTSTRAP_EMAILS=

# Sessions. Generate each secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=flowforge-api
JWT_AUDIENCE=flowforge-web
ACCESS_TOKEN_TTL=15m
# A sign-in lasts at most 1 day (refresh-token family), then Google sign-in is needed again.
REFRESH_TOKEN_TTL_DAYS=1
REFRESH_FAMILY_MAX_DAYS=1
COOKIE_SECRET=

# Development only. The API refuses to start if this is true with NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true

# A refresh token rotated this many seconds ago may be presented again without ending the session
# (two tabs or a retried request). After it, a replayed token ends every session of its family. 0 turns
# the grace off. See ADR 023.
REFRESH_REUSE_GRACE_SECONDS=10

# Optional rate limits (ADR 023), per minute. Counters are shared by every API process.
# Sign-in routes per client IP: a campus shares one public IP, so this is sized for thousands.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=600
# Google sign-ins per Google account.
AUTH_ACCOUNT_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Refreshes per session (refresh-token family), never per IP.
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=10

# Processes (`npm start` runs a cluster, one worker per CPU by default; `npm run start:single` runs
# one), and each one's connection pool. The API refuses to start when API_WORKERS × DB_POOL_MAX is
# more than DB_MAX_CONNECTIONS (the server's max_connections) minus DB_CONNECTION_HEADROOM.
API_WORKERS=2
DB_POOL_MAX=10
DB_MAX_CONNECTIONS=100
DB_CONNECTION_HEADROOM=10
# An event per query, for tests that count queries only.
DB_QUERY_EVENTS=false

# How long an idle keep-alive connection stays open. Keep it above the idle timeout of any proxy or
# load balancer in front (60 s for AWS ALB and nginx), so the API never closes a connection the proxy
# is about to reuse.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# Request bodies (JSON) nested deeper than this are refused with 400 BODY_TOO_DEEP.
MAX_BODY_DEPTH=32

# Marks and a "marked out of" scale for evaluations. Off (the default) means feedback-only grading:
# the API refuses marks and never returns them. The columns stay, so this is the only switch.
EVALUATION_MARKS_ENABLED=false

# Writes per user (H10): submissions per milestone, and every other authenticated write.
SUBMISSION_RATE_LIMIT_PER_MINUTE=10
WRITE_RATE_LIMIT_PER_MINUTE=120
# Versions a team may submit for one milestone; more is 409 VERSION_LIMIT_REACHED.
SUBMISSION_VERSION_LIMIT=50

# Proxies allowed to set X-Forwarded-For: false (default; the API is reached directly), loopback
# (a proxy on the same machine), its addresses or CIDRs separated by commas, or a hop count.
# Never "true": anyone could then pick their own IP and escape the per-IP limit.
TRUST_PROXY=false

# Runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://flowforge:replace_with_local_database_password@localhost:5432/flowforge?schema=public
FRONTEND_URL=http://localhost:5173

# Google Sign-In (OAuth client of type "Web application" in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
ALLOWED_HOSTED_DOMAIN=nst.rishihood.edu.in

# University identity rules
STUDENT_EMAIL_PATTERN=^[a-z]+\.[a-z]*(\d{2})[a-z]*@nst\.rishihood\.edu\.in$
STAFF_EMAIL_PATTERN=^[a-z]+\.[a-z]+\d?@nst\.rishihood\.edu\.in$
BATCH_BASE_YEAR=2000
BATCH_MIN_YEAR=2018
# Comma-separated staff emails that become ADMIN on login. Student emails are refused at boot.
ADMIN_BOOTSTRAP_EMAILS=

# Sessions. Generate each secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=flowforge-api
JWT_AUDIENCE=flowforge-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30
COOKIE_SECRET=

# Development only. The API refuses to start if this is true with NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true

# Optional rate limits for /api/auth routes, per IP per minute
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30

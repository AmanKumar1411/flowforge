VITE_API_BASE_URL=http://localhost:3000/api
# The dev login form on /login: put VITE_DEV_LOGIN=true in .env.development.local (git-ignored), so
# only `vite dev` shows it. A production build (`npm run build`) refuses to run with it on; the QA stack
# builds with --mode test. The API accepts it only with AUTH_DEV_LOGIN_ENABLED=true and NODE_ENV=test,
# or development on this machine.
# VITE_DEV_LOGIN=true
